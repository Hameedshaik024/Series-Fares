# AirIQ agent login (the credentials you already use at airiq.in)
AIRIQ_USER=your-airiq-username
AIRIQ_PASS=your-airiq-password

# Shared password the frontend must send as "Authorization: Bearer <this>"
# to use the app. Pick something long/random - this protects your AirIQ
# account from being used by anyone who finds the app's URL.
APP_PASSWORD=change-me-to-something-long-and-random

# WhatsApp sidecar (Node/Baileys) - internal only, never exposed publicly.
# Any random string; just needs to match between Flask and the sidecar
# (both read it from this same env in the container).
WHATSAPP_SHARED_SECRET=change-me-to-another-long-random-string

# Set after linking WhatsApp (scan the QR from the app's "Link WhatsApp"
# panel) and looking up each target group's ID via "Show my groups". One
# group per route - leave any blank to skip that route on send.
WHATSAPP_GROUP_ID_HYD_DXB=
WHATSAPP_GROUP_ID_HYD_RUH=
WHATSAPP_GROUP_ID_HYD_MCT=
